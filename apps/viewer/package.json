{
  "name": "@mobile-simulator/viewer",
  "version": "0.1.0",
  "private": true,
  "description": "React live simulator viewer. Binary frames on WebSocket; JSON control only.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mobile-simulator-viewer": "./dist/server/index.js"
  },
  "scripts": {
    "predev": "npm run build --workspace @mobile-simulator/protocol",
    "dev": "tsx server/index.ts",
    "prebuild": "npm run build --workspace @mobile-simulator/protocol",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "NODE_ENV=production node dist/server/index.js",
    "pretest": "npm run build --workspace @mobile-simulator/protocol",
    "test": "vitest run",
    "pretypecheck": "npm run build --workspace @mobile-simulator/protocol",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@mobile-simulator/protocol": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
